        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="h-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3864;" value="heading 状态机" vertex="1">
                    <mxGeometry height="30" width="500" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="h-idle" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" value="IDLE&lt;br&gt;未启用" vertex="1">
                    <mxGeometry height="90" width="150" x="60" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="h-turn" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" value="TURN&lt;br&gt;正在转向" vertex="1">
                    <mxGeometry height="90" width="150" x="330" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="h-hold" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" value="HOLD&lt;br&gt;已到位 / 锁航向" vertex="1">
                    <mxGeometry height="90" width="170" x="620" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="h-timeout" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" value="TIMEOUT&lt;br&gt;首次到位超时" vertex="1">
                    <mxGeometry height="90" width="170" x="620" y="300" as="geometry"/>
                </mxCell>
                <mxCell id="he1" edge="1" parent="1" source="h-idle" style="html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="h-turn" value="heading_start(目标)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he2" edge="1" parent="1" source="h-turn" style="html=1;endArrow=classic;exitX=1;exitY=0.3;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="h-hold" value="|err|≤3°&lt;br&gt;且 |rate|≤35°/s">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he3" edge="1" parent="1" source="h-turn" style="html=1;endArrow=classic;exitX=1;exitY=0.7;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="h-timeout" value="5 s 未到位&lt;br&gt;（调试 10 s）">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he4" edge="1" parent="1" source="h-timeout" style="html=1;endArrow=classic;exitX=0.5;exitY=0;entryX=1;entryY=0.25;labelBackgroundColor=#FFFFFF;" target="h-timeout" value="同一个 Y：锁存，不重启">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he5" edge="1" parent="1" source="h-timeout" style="html=1;endArrow=classic;exitX=0;exitY=0.5;entryX=0.5;entryY=1;labelBackgroundColor=#FFFFFF;" target="h-turn" value="新目标 / 手动取消后重发">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he6" edge="1" parent="1" source="h-hold" style="html=1;endArrow=classic;exitX=0;exitY=0.5;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;" target="h-turn" value="被推开：继续修正">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he7" edge="1" parent="1" source="h-turn" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=1;labelBackgroundColor=#FFFFFF;" target="h-idle" value="heading_cancel()&lt;br&gt;S / 掉线 / 手动指令">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he8" edge="1" parent="1" source="h-hold" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="h-idle" value="cancel">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="he9" edge="1" parent="1" source="h-timeout" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.9;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="h-idle" value="cancel">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="h-note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="状态含义&lt;br&gt;IDLE：不参与控制，网页/手动目标直接给轮速。&lt;br&gt;TURN：第一次接近目标，5 s 超时。&lt;br&gt;HOLD：已经到过目标，持续锁航向，不超时。&lt;br&gt;TIMEOUT：超时停车，并锁存同一个目标，防止网页重发反复顶障碍物。" vertex="1">
                    <mxGeometry height="120" width="650" x="60" y="470" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="heading-update" name="4-update流程">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="u-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3864;" value="heading_update() 每一步" vertex="1">
                    <mxGeometry height="30" width="500" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="u-start" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="进入 heading_update()" vertex="1">
                    <mxGeometry height="50" width="240" x="60" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="u-active" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="state == TURN&lt;br&gt;或 HOLD ?" vertex="1">
                    <mxGeometry height="90" width="200" x="80" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="u-return" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="return&lt;br&gt;不控制" vertex="1">
                    <mxGeometry height="50" width="130" x="330" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="u-timeout" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="state == TURN&lt;br&gt;且超时 ?" vertex="1">
                    <mxGeometry height="90" width="200" x="80" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="u-tout" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="TIMEOUT&lt;br&gt;输出 0，return" vertex="1">
                    <mxGeometry height="60" width="170" x="330" y="345" as="geometry"/>
                </mxCell>
                <mxCell id="u-err" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="err = wrap180(s_target - yaw)&lt;br&gt;rate = yaw_rate_dps" vertex="1">
                    <mxGeometry height="70" width="250" x="60" y="480" as="geometry"/>
                </mxCell>
                <mxCell id="u-window" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="|err| ≤ 3°&lt;br&gt;且 |rate| ≤ 35°/s ?" vertex="1">
                    <mxGeometry height="100" width="210" x="80" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="u-hold" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="TURN → HOLD&lt;br&gt;left=right=0&lt;br&gt;return" vertex="1">
                    <mxGeometry height="70" width="180" x="350" y="615" as="geometry"/>
                </mxCell>
                <mxCell id="u-pd" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="u = KP*err - KD*rate" vertex="1">
                    <mxGeometry height="60" width="250" x="60" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="u-lim" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="限幅 ±MAX_RPM&lt;br&gt;再套最小转速 MIN_RPM" vertex="1">
                    <mxGeometry height="60" width="250" x="60" y="860" as="geometry"/>
                </mxCell>
                <mxCell id="u-sign" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="u *= HEADING_OUTPUT_SIGN&lt;br&gt;left = -u, right = +u" vertex="1">
                    <mxGeometry height="60" width="250" x="60" y="960" as="geometry"/>
                </mxCell>
                <mxCell id="ue1" edge="1" parent="1" source="u-start" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="u-active">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue2" edge="1" parent="1" source="u-active" style="html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="u-return" value="否">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue3" edge="1" parent="1" source="u-active" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;" target="u-timeout" value="是">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue4" edge="1" parent="1" source="u-timeout" style="html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="u-tout" value="是">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue5" edge="1" parent="1" source="u-timeout" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;" target="u-err" value="否">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue6" edge="1" parent="1" source="u-err" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="u-window">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue7" edge="1" parent="1" source="u-window" style="html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="u-hold" value="是">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue8" edge="1" parent="1" source="u-window" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;" target="u-pd" value="否">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue9" edge="1" parent="1" source="u-pd" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="u-lim">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ue10" edge="1" parent="1" source="u-lim" style="html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="u-sign">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="sign-180" name="5-符号与180°">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="s-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3864;" value="两个符号 + 为什么会差 180°" vertex="1">
                    <mxGeometry height="30" width="600" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="s-imu" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="IMU_YAW_SIGN&lt;br&gt;定义 yaw 正方向&lt;br&gt;-1：顺时针为正&lt;br&gt;+1：逆时针为正" vertex="1">
                    <mxGeometry height="100" width="240" x="50" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="s-out" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="HEADING_OUTPUT_SIGN&lt;br&gt;定义电机输出方向&lt;br&gt;要满足：正误差 → yaw 增大" vertex="1">
                    <mxGeometry height="100" width="300" x="360" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="s-correct" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" value="符号正确&lt;br&gt;e = target - yaw&lt;br&gt;dyaw/dt = -K · e&lt;br&gt;yaw 收敛到 target" vertex="1">
                    <mxGeometry height="100" width="320" x="50" y="300" as="geometry"/>
                </mxCell>
                <mxCell id="s-wrong" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" value="符号错误&lt;br&gt;dyaw/dt = +K · e&lt;br&gt;目标点变不稳定&lt;br&gt;跑到 ±180°，wrap180 翻符号&lt;br&gt;稳定在 target ± 180°" vertex="1">
                    <mxGeometry height="130" width="380" x="50" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="s-test" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="如何判断&lt;br&gt;1. 手转车头向右：yaw 应增大。&lt;br&gt;2. 发 L60：左轮后退、右轮前进。&lt;br&gt;   - yaw 减小 → OUTPUT_SIGN = -1&lt;br&gt;   - yaw 增大 → OUTPUT_SIGN = +1&lt;br&gt;3. 一次只改一个符号，烧录后再测。" vertex="1">
                    <mxGeometry height="150" width="420" x="500" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="s-current" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=10;" value="当前代码值&lt;br&gt;IMU_YAW_SIGN = -1&lt;br&gt;HEADING_OUTPUT_SIGN = +1&lt;br&gt;&lt;br&gt;改完一次只烧一个，&lt;br&gt;再看 yaw 是变大还是变小。" vertex="1">
                    <mxGeometry height="150" width="300" x="800" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="s-current-note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" value="判断顺序&lt;br&gt;1. 手转车头向右：yaw 应增大。&lt;br&gt;2. 发 L60：看 yaw 增大/减小。&lt;br&gt;3. 只改一个宏，重新烧录。&lt;br&gt;4. Y90 验证是否还差 180°。" vertex="1">
                    <mxGeometry height="150" width="330" x="800" y="560" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>