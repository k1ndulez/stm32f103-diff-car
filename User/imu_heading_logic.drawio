    <diagram id="imu-detail" name="2-IMU">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="i-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3864;" value="IMU：初始化 → 校准 → 每 20 ms 更新" vertex="1">
                    <mxGeometry height="30" width="760" x="40" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="i-init" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="imu_init()&lt;br&gt;I2C 读 WHO_AM_I=0x70&lt;br&gt;唤醒 0x6B=0x01&lt;br&gt;陀螺 ±250°/s&lt;br&gt;加速度 ±2g" vertex="1">
                    <mxGeometry height="120" width="230" x="40" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="i-cal" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="imu_calibrate()&lt;br&gt;静止采 200 次&lt;br&gt;求 gz 平均零偏&lt;br&gt;s_bias_gz = avg&lt;br&gt;yaw = 0" vertex="1">
                    <mxGeometry height="120" width="230" x="330" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="i-upd" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="imu_update(dt)&lt;br&gt;读 14 字节&lt;br&gt;dps = (gz - bias) / 131.07&lt;br&gt;dps *= IMU_YAW_SIGN&lt;br&gt;yaw += dps * dt / 1000&lt;br&gt;yaw 限幅 -180~180" vertex="1">
                    <mxGeometry height="150" width="280" x="620" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="i-reg" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="MPU6050 寄存器&lt;br&gt;0x3B AX AY AZ&lt;br&gt;0x41 温度&lt;br&gt;0x43 GX GY GZ" vertex="1">
                    <mxGeometry height="100" width="210" x="40" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="i-read" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="imu_read()&lt;br&gt;I2C Mem Read 0x3B, 14 字节&lt;br&gt;高字节在前&lt;br&gt;int16 组合" vertex="1">
                    <mxGeometry height="100" width="230" x="310" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="i-raw" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="imu_raw_t&lt;br&gt;ax ay az&lt;br&gt;gx gy gz" vertex="1">
                    <mxGeometry height="100" width="190" x="610" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="i-note" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" value="重点&lt;br&gt;1. 只有陀螺仪，没有磁力计，yaw 是相对角，不是绝对方向。&lt;br&gt;2. 上电静止校准，之后零偏仍会随温度/时间漂。&lt;br&gt;3. 目前没有运行中 ZUPT/零速修正。&lt;br&gt;4. IMU_YAW_SIGN 决定 yaw 正方向；手转右应增大。" vertex="1">
                    <mxGeometry height="120" width="780" x="40" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="ie1" edge="1" parent="1" source="i-init" style="html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="i-cal" value="成功">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie2" edge="1" parent="1" source="i-cal" style="html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="i-upd" value="进入循环">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie3" edge="1" parent="1" source="i-reg" style="html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="i-read">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie4" edge="1" parent="1" source="i-read" style="html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" target="i-raw">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie5" edge="1" parent="1" source="i-raw" style="html=1;endArrow=classic;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=#FFFFFF;" target="i-upd" value="gz">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
