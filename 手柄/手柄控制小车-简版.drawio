                <mxCell id="e5" edge="1" parent="1" source="b5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="b6" value="电波">
                    <mxGeometry relative="1" as="geometry"/>
